---
import Layout from '../layouts/Layout.astro';
import NotesList from '../components/NotesList.astro';
import FAB from '../components/FAB.astro';
import NoteModal from '../components/NoteModal.astro';

// All logic and state below is client-side:
const [notes, setNotes] = Astro.useState([]);
const [showModal, setShowModal] = Astro.useState(false);
const [editingNote, setEditingNote] = Astro.useState(null);
const [editMode, setEditMode] = Astro.useState(false);

function genId() {
  return `${Date.now()}-${Math.random().toString(36).substr(2,7)}`;
}

Astro.onMount(() => {
  if (typeof window === "undefined") return;
  const stored = window.localStorage.getItem('notes');
  setNotes(stored ? JSON.parse(stored) : []);
});

function persistNotes(n) {
  if (typeof window !== "undefined") {
    window.localStorage.setItem('notes', JSON.stringify(n));
  }
  setNotes(n);
}

// PUBLIC_INTERFACE
function handleCreateNote(data) {
  const newNote = {
    id: genId(),
    title: data.title,
    content: data.content,
    createdAt: Date.now()
  };
  const updated = [newNote, ...notes];
  persistNotes(updated);
  setShowModal(false);
}

// PUBLIC_INTERFACE
function handleEditNote(id) {
  const note = notes.find(n => n.id === id);
  setEditingNote(note);
  setEditMode(true);
  setShowModal(true);
}

// PUBLIC_INTERFACE
function handleSaveEditNote(updatedNote) {
  const updated = notes.map(n => (n.id === updatedNote.id ? { ...n, title: updatedNote.title, content: updatedNote.content } : n));
  persistNotes(updated);
  setShowModal(false);
  setEditMode(false);
  setEditingNote(null);
}

// PUBLIC_INTERFACE
function handleDeleteNote(id) {
  if (!confirm("Are you sure you want to delete this note?")) return;
  const updated = notes.filter(n => n.id !== id);
  persistNotes(updated);
}

// PUBLIC_INTERFACE
function handleOpenModal() {
  setEditMode(false);
  setEditingNote(null);
  setShowModal(true);
}

// PUBLIC_INTERFACE
function handleCloseModal() {
  setShowModal(false);
  setEditMode(false);
  setEditingNote(null);
}

---
<Layout>
  <header class="main-header">
    <h1 class="app-title">
      <svg viewBox="0 0 28 28" width="28" height="28" style="vertical-align:middle;margin-right:.38em;"><circle cx="14" cy="14" r="14" fill="#4F8A8B"/><path d="M8 10c.7-1.2 2.1-2.1 4-2.1s3.3.9 4 2.1" fill="none" stroke="#fff" stroke-width="1.6"/><rect x="7.5" y="12.5" width="13" height="8" rx="1.6" fill="#fff" stroke="#4F8A8B" stroke-width="1.2"/><rect x="10" y="15" width="7" height="1.5" rx=".7" fill="#F49D37"/><rect x="10" y="17.5" width="4.5" height="1.2" rx=".6" fill="#D7263D"/></svg>
      NoteEase
    </h1>
  </header>
  <main class="notes-main">
    <NotesList 
      notes={notes} 
      onEdit={handleEditNote}
      onDelete={handleDeleteNote}
    />
    <FAB onClick={handleOpenModal} label="Create new note"/>
    <NoteModal
      show={showModal}
      onClose={handleCloseModal}
      onSave={editMode ? handleSaveEditNote : handleCreateNote}
      editing={editMode}
      note={editingNote}
    />
  </main>
</Layout>
<style>
  .main-header {
    width: 100%;
    min-height: 64px;
    padding: 1.3rem 0 0.85rem 0;
    background: #fff;
    border-bottom: 1.8px solid var(--border-color);
    margin-bottom: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    position: sticky;
    top: 0;
  }
  .app-title {
    margin: 0;
    color: #4F8A8B;
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.2em;
    user-select: none;
  }
  .notes-main {
    margin: 0 auto;
    max-width: 1020px;
    padding: 0 1.1rem 1.5rem 1.1rem;
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: relative;
  }
  @media (max-width: 700px) {
    .main-header {
      min-height: 50px;
      padding: 0.71rem 0 0.6rem 0;
      margin-bottom: 1.2rem;
    }
    .app-title {
      font-size: 1.25rem;
    }
    .notes-main {
      padding: 0 0.4rem 0.8rem 0.4rem;
    }
  }
</style>
